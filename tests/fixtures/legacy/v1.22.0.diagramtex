{
 "app": "diagramtex",
 "version": 3,
 "kind": "classic",
 "name": "Welcome to DiagramTeX",
 "page": {
  "paper": "a4",
  "orient": "portrait",
  "w": 21,
  "h": 29.7,
  "mt": 2.5,
  "mb": 2.5,
  "ml": 2.5,
  "mr": 2.5,
  "font": 11,
  "title": true,
  "spread": 1,
  "numbered": false
