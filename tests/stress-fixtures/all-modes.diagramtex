\theta$}\n\\end{tikzpicture}","id":"page-2558"},{"type":"geo2d","x":2107,"y":311143,"src":"\\begin{tikzpicture}\n  % the vector v = (\\vlen; \\vang°): drag Q, or change the values\n  \\pgfmathsetmacro{\\vlen}{4}\n  \\pgfmathsetmacro{\\vang}{53.17}\n  \\pgfmathsetmacro{\\dx}{\\vlen*cos(\\vang)}\n  \\pgfmathsetmacro{\\dy}{\\vlen*sin(\\vang)}\n  \\draw[step=1, very thin, black!15] (-1,-1) grid (4,4);\n  \\draw[-stealth] (-1,0) -- (4.4,0) node[right]{$x$};\n  \\draw[-stealth] (0,-1) -- (0,4.4) node[above]{$y$};\n  \\foreach \\x in {1,...,3} \\draw (\\x,2pt) -- (\\x,-2pt) node[below]{$\\x$};\n  \\foreach \\y in {1,...,3} \\draw (2pt,\\y) -- (-2pt,\\y) node[left]{$\\y$};\n  \\coordinate (P) at (0,0);\n  \\coordinate (Q) at (\\vang:\\vlen);\n  \\coordinate (R) at (Q |- P);\n  \\draw[dashed, gray] (Q) -- (R) node[midway, right]{$\\Delta y = \\pgfmathprintnumber[fixed,precision=2]{\\dy}$};\n  \\path (P) -- (R) node[pos=0.62, above]{$\\Delta x = \\pgfmathprintnumber[fixed,precision=2]{\\dx}$};\n  \\pic[draw, \"$\\theta$\", angle radius=8mm] {angle = R--P--Q};\n  \\draw[-stealth, thick, blue] (P) -- (Q) node[midway, above left]{$\\vec{v}$};\n  \\fill (P) circle (1.5pt) node[below left]{$P$};\n  \\fill (Q) circle (1.5pt) node[above right]{$Q$};\n\\end{tikzpicture}","id":"page-2559"},{"type":"qc","x":40,"y":311720,"src":"\\begin{quantikz}\n\\lstick{\\ket{0}} & \\gate{H} & \\ctrl{1} & \\meter{} \\\\\n\\lstick{\\ket{0}} & & \\targ{} & \\meter{}\n\\end{quantikz}","size":"large","font":"default","color":"#000000","id":"page-2560"},{"type":"forest","x":729,"y":311720,"src":"\\begin{forest}\n  for tree={draw, rounded corners}\n  [Root\n    [Branch [Leaf] [Leaf]]\n    [Branch [Leaf]]\n  ]\n\\end{forest}","size":"large","font":"default","color":"#000000","id":"page-2561"},{"type":"zx","x":1418,"y":311720,"src":"\\begin{ZX}\n\\zxN{} \\rar &[\\zxwCol] \\zxZ{\\alpha} \\ar[r,o',H] \\ar[r,o.] &[\\zxHCol] \\zxX-{\\beta} \\rar &[\\zxwCol] \\zxN{}\n\\end{ZX}","color":"#000000","id":"page-2562"},{"type":"feynman","x":2107,"y":311720,"src":"\\begin{feynman}\n  \\vertex (i1) at (0,1) {\\(e^-\\)};\n  \\vertex (i2) at (0,-1) {\\(e^+\\)};\n  \\vertex (a) at (1.25,0);\n  \\vertex (b) at (3.25,0);\n  \\vertex (f1) at (4.5,1) {\\(\\mu^-\\)};\n  \\vertex (f2) at (4.5,-1) {\\(\\mu^+\\)};\n  \\diagram* {\n    (i1) -- [fermion] (a) -- [fermion] (i2),\n    (a) -- [photon, edge label=\\(\\gamma\\), momentum'=\\(q\\)] (b),\n    (f2) -- [fermion] (b) -- [fermion] (f1),\n  };\n\\end{feynman}","color":"#000000","id":"page-2563"},{"type":"timing","x":40,"y":312177,"src":"\\begin{tikztimingtable}[timing/rowdist=3]\n  CLK & 8{2C} \\\\\n  D   & 3U 4D{A} 4D{B} 5U \\\\\n  Q   & 7X 4D{A} 5D{B} \\\\\n\\extracode\n  \\vertlines[help lines]{2,6,10,14}\n  \\draw [<->] (3,-1.5) -- node [above, font=\\footnotesize] {$t_{su}$} (6,-1.5);\n  \\draw [<->] (6,-4.5) -- node [above, font=\\footnotesize] {$t_{h}$} (7,-4.5);\n  \\draw [->] (6,-7.5) -- node [above, font=\\footnotesize] {$t_{co}$} (7,-7.5);\n\\end{tikztimingtable}","color":"#000000","id":"page-2564"},{"type":"automata","x":729,"y":312177,"src":"\\begin{tikzpicture}[->, >=Stealth, shorten >=1pt, auto, node distance=2.5cm, semithick]\n  \\node[state, initial] (q0) at (0,0) {$q_0$};\n  \\node[state] (q1) at (2.5,0) {$q_1$};\n  \\node[state, accepting] (q2) at (5,0) {$q_2$};\n  \\path (q0) edge node {$a$} (q1)\n        (q1) edge [loop above] node {$b$} ()\n        (q1) edge [bend left] node {$a$} (q2)\n        (q2) edge [bend left] node {$b$} (q1);\n\\end{tikzpicture}","color":"#000000","id":"page-2565"},{"type":"uml","x":1418,"y":312177,"src":"\\begin{tikzpicture}\n  \\begin{abstractclass}[text width=3.6cm]{Shape}{0,0}\n    \\attribute{- name : String}\n    \\operation[0]{+ area() : double}\n  \\end{abstractclass}\n  \\begin{class}[text width=3.2cm]{Circle}{-2.2,-3.4}\n    \\inherit{Shape}\n    \\attribute{- radius : double}\n    \\operation{+ area() : double}\n  \\end{class}\n  \\begin{class}[text width=3.2cm]{Square}{2.2,-3.4}\n   