node[below]{$\\x$};\n  \\foreach \\y in {1,...,3} \\draw (2pt,\\y) -- (-2pt,\\y) node[left]{$\\y$};\n  \\coordinate (P) at (0,0);\n  \\coordinate (Q) at (\\vang:\\vlen);\n  \\coordinate (R) at (Q |- P);\n  \\draw[dashed, gray] (Q) -- (R) node[midway, right]{$\\Delta y = \\pgfmathprintnumber[fixed,precision=2]{\\dy}$};\n  \\path (P) -- (R) node[pos=0.62, above]{$\\Delta x = \\pgfmathprintnumber[fixed,precision=2]{\\dx}$};\n  \\pic[draw, \"$\\theta$\", angle radius=8mm] {angle = R--P--Q};\n  \\draw[-stealth, thick, blue] (P) -- (Q) node[midway, above left]{$\\vec{v}$};\n  \\fill (P) circle (1.5pt) node[below left]{$P$};\n  \\fill (Q) circle (1.5pt) node[above right]{$Q$};\n\\end{tikzpicture}","id":"document-908"},{"type":"qc","x":729,"y":954,"src":"\\begin{quantikz}\n\\lstick{\\ket{0}} & \\gate{H} & \\ctrl{1} & \\meter{} \\\\\n\\lstick{\\ket{0}} & & \\targ{} & \\meter{}\n\\end{quantikz}","size":"large","font":"default","color":"#000000","id":"document-909"},{"type":"forest","x":1418,"y":954,"src":"\\begin{forest}\n  for tree={draw, rounded corners}\n  [Root\n    [Branch [Leaf] [Leaf]]\n    [Branch [Leaf]]\n  ]\n\\end{forest}","size":"large","font":"default","color":"#000000","id":"document-910"},{"type":"zx","x":2107,"y":954,"src":"\\begin{ZX}\n\\zxN{} \\rar &[\\zxwCol] \\zxZ{\\alpha} \\ar[r,o',H] \\ar[r,o.] &[\\zxHCol] \\zxX-{\\beta} \\rar &[\\zxwCol] \\zxN{}\n\\end{ZX}","color":"#000000","id":"document-911"}],"caption":"Mixed elements 901–912"},{"type":"table","rows":[["Quantity","Value"],["$\\hat x$","$\\frac{1}{1+x^2}$"],["Index","900"]],"header":true,"borders":"all","colAlign":"c"},{"type":"text","text":"\\subsection{Mixed batch 77}\n$\\displaystyle\\int_0^\\infty e^{-x^2}\\,dx=\\frac{\\sqrt\\pi}{2}+b_{912}$ · $\\hat{x}+\\widehat{AB}+\\vec{F}+b_{913}$ · $\\sum_{k=1}^{n}k^2=\\frac{n(n+1)(2n+1)}6+b_{914}$ · $\\begin{pmatrix}a&b\\\\c&d\\end{pmatrix}+b_{915}$ · $\\cos^2u-\\sin^2u+b_{916}$ · $\\frac{\\partial^2 f}{\\partial x\\partial y}+b_{917}$ · $\\sqrt[3]{1+x^2}+b