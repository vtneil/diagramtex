len);\n  \\coordinate (R) at (Q |- P);\n  \\draw[dashed, gray] (Q) -- (R) node[midway, right]{$\\Delta y = \\pgfmathprintnumber[fixed,precision=2]{\\dy}$};\n  \\path (P) -- (R) node[pos=0.62, above]{$\\Delta x = \\pgfmathprintnumber[fixed,precision=2]{\\dx}$};\n  \\pic[draw, \"$\\theta$\", angle radius=8mm] {angle = R--P--Q};\n  \\draw[-stealth, thick, blue] (P) -- (Q) node[midway, above left]{$\\vec{v}$};\n  \\fill (P) circle (1.5pt) node[below left]{$P$};\n  \\fill (Q) circle (1.5pt) node[above right]{$Q$};\n\\end{tikzpicture}","id":"document-2051"}],"caption":"Mixed elements 2041–2052"},{"type":"table","rows":[["Quantity","Value"],["$\\hat x$","$\\frac{1}{1+x^2}$"],["Index","2040"]],"header":true,"borders":"all","colAlign":"c"},{"type":"text","text":"\\subsection{Mixed batch 172}\n$\\displaystyle\\int_0^\\infty e^{-x^2}\\,dx=\\frac{\\sqrt\\pi}{2}+b_{2052}$ · $\\hat{x}+\\widehat{AB}+\\vec{F}+b_{2053}$ · $\\sum_{k=1}^{n}k^2=\\frac{n(n+1)(2n+1)}6+b_{2054}$ · $\\begin{pmatrix}a&b\\\\c&d\\end{pmatrix}+b_{2055}$ · $\\cos^2u-\\sin^2u+b_{2056}$ · $\\frac{\\partial^2 f}{\\partial x\\partial y}+b_{2057}$ · $\\sqrt[3]{1+x^2}+b_{2058}$ · $\\overbrace{a+b+c}^{n}+b_{2059}$ · $\\lim_{x\\to0}\\frac{\\sin x}{x}=1+b_{2060}$ · $\\mathbf A\\boldsymbol\\alpha=\\lambda\\mathbf v+b_{2061}$ · $\\begin{aligned}a&=b+c\\\\d&=e-f\\end{aligned}+b_{2062}$ · $\\prod_{j=1}^{n}\\left(1+\\frac1{j^2}\\right)+b_{2063}$"},{"type":"diagram","shapes":[{"type":"qc","x":40,"y":40,"src":"\\begin{quantikz}\n\\lstick{\\ket{0}} & \\gate{H} & \\ctrl{1} & \\meter{} \\\\\n\\lstick{\\ket{0}} & & \\targ{} & \\meter{}\n\\end{quantikz}","size":"large","font":"default","color":"#000000","id":"document-2052"},{"type":"forest","x":729,"y":40,"src":"\\begin{forest}\n  for tree={draw, rounded corners}\n  [Root\n    [Branch [Leaf] [Leaf]]\n    [Branch [Leaf]]\n  ]\n\\end{forest}","size":"large","font":"default","color":"#000000","id":"document-2053"},{"type":"zx","x":1418,"y":40,"src":"\\begin{ZX}\n\\zxN{} \\rar &[\\zxw