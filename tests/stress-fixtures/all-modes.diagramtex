\\tdplotsetthetaplanecoords{\\phivec}\n  \\tdplotdrawarc[tdplot_rotated_coords]{(0,0,0)}{0.5}{0}{\\thetavec}{anchor=south west}{$\\theta$}\n\\end{tikzpicture}","id":"document-2685"},{"type":"geo2d","x":1418,"y":954,"src":"\\begin{tikzpicture}\n  % the vector v = (\\vlen; \\vang°): drag Q, or change the values\n  \\pgfmathsetmacro{\\vlen}{4}\n  \\pgfmathsetmacro{\\vang}{53.17}\n  \\pgfmathsetmacro{\\dx}{\\vlen*cos(\\vang)}\n  \\pgfmathsetmacro{\\dy}{\\vlen*sin(\\vang)}\n  \\draw[step=1, very thin, black!15] (-1,-1) grid (4,4);\n  \\draw[-stealth] (-1,0) -- (4.4,0) node[right]{$x$};\n  \\draw[-stealth] (0,-1) -- (0,4.4) node[above]{$y$};\n  \\foreach \\x in {1,...,3} \\draw (\\x,2pt) -- (\\x,-2pt) node[below]{$\\x$};\n  \\foreach \\y in {1,...,3} \\draw (2pt,\\y) -- (-2pt,\\y) node[left]{$\\y$};\n  \\coordinate (P) at (0,0);\n  \\coordinate (Q) at (\\vang:\\vlen);\n  \\coordinate (R) at (Q |- P);\n  \\draw[dashed, gray] (Q) -- (R) node[midway, right]{$\\Delta y = \\pgfmathprintnumber[fixed,precision=2]{\\dy}$};\n  \\path (P) -- (R) node[pos=0.62, above]{$\\Delta x = \\pgfmathprintnumber[fixed,precision=2]{\\dx}$};\n  \\pic[draw, \"$\\theta$\", angle radius=8mm] {angle = R--P--Q};\n  \\draw[-stealth, thick, blue] (P) -- (Q) node[midway, above left]{$\\vec{v}$};\n  \\fill (P) circle (1.5pt) node[below left]{$P$};\n  \\fill (Q) circle (1.5pt) node[above right]{$Q$};\n\\end{tikzpicture}","id":"document-2686"},{"type":"qc","x":2107,"y":954,"src":"\\begin{quantikz}\n\\lstick{\\ket{0}} & \\gate{H} & \\ctrl{1} & \\meter{} \\\\\n\\lstick{\\ket{0}} & & \\targ{} & \\meter{}\n\\end{quantikz}","size":"large","font":"default","color":"#000000","id":"document-2687"}],"caption":"Mixed elements 2677–2688"},{"type":"table","rows":[["Quantity","Value"],["$\\hat x$","$\\frac{1}{1+x^2}$"],["Index","2676"]],"header":true,"borders":"all","colAlign":"c"},{"type":"text","text":"\\subsection{Mixed batch 225}\n$\\displaystyle\\int_0^\\infty e^{-x^2}\\,dx=\\frac{\\sqrt\\pi}{2}+b_{2688}$ · $\\hat{x}+\\widehat{AB}+\\vec{F}+b_{2689}$ · $\\sum_{k=1}^{n}k^2=\\frac{n(n+1)(2n+1)}6+b_{2690}$ · $\\begin{pmatrix}a&b\\\\c&d\\end{pmatrix}+b_{2691}$ · $\\cos^2u-\\sin^2u+b_{2692}$ · $\\frac{\\partial^2 f}{\\partial x\\partial y}+b_{2693}$ · $\\sqrt[3]{1+x^2}+b_{2694}$ · $\\overbrace{a+b+c}^{n}+b_{2695}$ · $\\lim_{x\\to0}\\frac{\\sin x}{x}=1+b_{2696}$ · $\\mathbf A\\boldsymbol\\alpha=\\lambda\\mathbf v+b_{2697}$ · $\\begin{aligned}a&=b+c\\\\d&=e-f\\end{aligned}+b_{2698}$ · $\\prod_{j=1}^{n}\\left(1+\\frac1{j^2}\\right)+b_{2699}$"},{"type":"diagram","shapes":[{"type":"forest","x":40,"y":40,"src":"\\begin{forest}\n  for tree={draw, rounded corners}\n  [Root\n    [Branch [Leaf] [Leaf]]\n    [Branch [Leaf]]\n  ]\n\\end{forest}","size":"large","font":"default","color":"#000000","id":"document-2688"},{"type":"zx","x":729,"y":40,"src":"\\begin{ZX}\n\\zxN{} \\rar &[\\zxwCol] \\zxZ{\\alpha} \\ar[r,o',H] \\ar[r,o.] &[\\zxHCol] \\zxX-{\\beta} \\rar &[\\zxwCol] \\zxN{}\n\\end{ZX}","color":"#000000","id":"document-2689"},{"type":"feynman","x":1418,"y":40,"src":"\\begin{feynman}\n  \\vertex (i1) at (0,1) {\\(e^-\\)};\n  \\vertex (i2) at (0,-1) {\\(e^+\\)};\n  \\vertex (a) at (1.25,0);\n  \\vertex (b) at (3.25,0);\n  \\vertex (f1) at (4.5,1) {\\(\\mu^-\\)};\n  \\vertex (f2) at (4.5,-1) {\\(\\mu^+\\)};\n  \\diagram* {\n    (i1) -- [fermion] (a) -- [fermion] (i2),\n    (a) -- [photon, edge label=\\(\\gamma\\), momentum'=\\(q\\)] (b),\n    (f2) -- [fermion] (b) -- [fermion] (f1),\n  };\n\\end{feynman}","color":"#000000","id":"document-2690"},{"type":"timing","x":2107,"y":40,"src":"\\begin{tikztimingtable}[timing/rowdist=3]\n  CLK & 8{2C} \\\\\n  D   & 3U 4D{A} 4D{B} 5U \\\\\n  Q   & 7X 4D{A} 5D{B} \\\\\n\\extracode\n  \\vertlines[help lines]{2,6,10,14}\n  \\draw [<->] (3,-1.5) -- node [above, font=\\footnotesize] {$t_{su}$} (6,-1.5);\n  \\draw [<->] (6,-4.5) -- node [above, font=\\footnotesize] {$t_{h}$} (7,-4.5);\n  \\draw [->] (6,-7.5) -- node [above, font=\\footnotesize] {$t_{co}$} (7,-7.5);\n\\end{tikztimingtable}","color":"#000000","id":"document-2691"},{"type":"automata","x":40,"y":497,"src":"\\begin{tikzpicture}[->, >=Stealth, shorten >=1pt, auto, node distance=2.5cm, semithick]\n  \\node[state, initial] (q0) at (0,0) {$q_0$};\n  \\node[state] (q1) at (2.5,0) {$q_1$};\n  \\node[state, accepting] (q2) at (5,0) {$q_2$};\n  \\path (q0) edge node {$a$} (q1)\n        (q1) edge [loop above] node {$b$} ()\n        (q1) edge [bend left] node {$a$} (q2)\n        (q2) edge [bend left] node {$b$} (q1);\n\\end{tikzpicture}","color":"#000000","id":"document-2692"},{"type":"uml","x":729,"y":497,"src":"\\begin{tikzpicture}\n  \\begin{abstractclass}[text width=3.6cm]{Shape}{0,0}\n    \\attribute{- name : String}\n    \\operation[0]{+ area() : double}\n  \\end{abstractclass}\n  \\begin{class}[text width=3.2cm]{Circle}{-2.2,-3.4}\n    \\inherit{Shape}\n    \\attribute{- radius : double}\n    \\operation{+ area() : double}\n  \\end{class}\n  \\begin{class}[text width=3.2cm]{Square}{2.2,-3.4}\n    \\inherit{Shape}\n    \\attribute{- side : double}\n    \\operation{+ area() : double}\n  \\end{class}\n\\end{tikzpicture}","id":"document-2693"},{"type":"umlsd","x":1418,"y":497,"src":"\\begin{sequencediagram}\n  \\newthread{c}{:Client}\n  \\newinst[1]{s}{:Server}\n  \\newinst[1]{d}{:Database}\n  \\begin{call}{c}{request()}{s}{response}\n    \\begin{call}{s}{query()}{d}{rows}\n    \\end{call}\n  \\end{call}\n\\end{sequencediagram}","id":"document-2694"},{"type":"kmap","x":2107,"y":497,"src":"\\begin{karnaugh-map}[4][4][1][$D$][$C$][$B$][$A$]\n  \\minterms{0,2,5,7,8,10,13,15}\n  \\autoterms[0]\n  \\implicant{5}{15}\n  \\implicantcorner\n\\end{karnaugh-map}","color":"#000000","id":"document-2695"},{"type":"bytefield","x":40,"y":954,"src":"\\begin{bytefield}[bitwidth=1.1em]{32}\n  \\bitheader{0,7,8,15,16,23,24,31} \\\\\n  \\begin{rightwordgroup}{Header}\n    \\bitbox{4}{Version} & \\bitbox{4}{IHL} & \\bitbox{8}{Type of service} & \\bitbox{16}{Total length} \\\\\n    \\bi