}\n% a frame moving at 0.5c: its axes tilt toward the light line; drag the event\n\\range(-1, 4)(-0.5, 4)\n\\frame[beta=0.5, name=S']\n\\lightcone(0, 0)\n\\event[label=$A$, guides=true](2, 3)","id":"page-1103"},{"type":"physics","x":40,"y":134452,"src":"\\physics{levels}\n% the Balmer series of hydrogen and its visible spectrum\n\\setup[scale=0.32]\n\\hydrogen[n=6]\n\\transition(3)(2)\n\\transition(4)(2)\n\\transition(5)(2)\n\\transition(6)(2)\n\\spectrum(0, -6)","id":"page-1104"},{"type":"physics","x":729,"y":134452,"src":"\\physics{mechanics}\n% a block on a rough incline: drag the top corner to change the angle\n\\incline[angle=30, L=5, mu=0.4](0, 0)\n\\block[m=2, s=0.55, label=$m$](incline)","id":"page-1105"},{"type":"prim3d","x":1418,"y":134452,"w":240,"h":220,"kind":"box","style":"shaded","a":"2","b":"1.5","c":"1.2","r2":"0.6","n":"6","sl":"","r1":"0.8","t1":"0","t2":"70","p1":"20","p2":"60","view":[30,20],"axes":false,"axesNeg":true,"xlabel":"$x$","ylabel":"$y$","zlabel":"$z$","hiddenEdges":true,"solidColor":"#2f7fc1","la":"$a$","lb":"$b$","lc":"$c$","name":"","nameBelow":"","id":"page-1106"},{"type":"prim3d","x":2107,"y":134452,"w":200,"h":200,"kind":"sphere","style":"shaded","a":"1.2","b":"1.5","c":"1.2","r2":"0.6","n":"6","sl":"","r1":"0.8","t1":"0","t2":"70","p1":"20","p2":"60","view":[30,20],"axes":false,"axesNeg":true,"xlabel":"$x$","ylabel":"$y$","zlabel":"$z$","hiddenEdges":true,"solidColor":"#2f7fc1","la":"$r$","lb":"","lc":"","name":"","nameBelow":"","id":"page-1107"},{"type":"prim3d","x":40,"y":134909,"w":200,"h":240,"kind":"cylinder","style":"shaded","a":"1","b":"1.5","c":"2","r2":"0.6","n":"6","sl":"","r1":"0.8","t1":"0","t2":"70","p1":"20","p2":"60","view":[30,20],"axes":false,"axesNeg":true,"xlabel":"$x$","ylabel":"$y$","zlabel":"$z$","hiddenEdges":true,"solidColor":"#2f7fc1","la":"$r$","lb":"","lc":"$h$","name":"","nameBelow":"","id":"page-1108"},{"type":"prim3d","x":729,"y":134909,"w":200,"h":240,"kind":"cone","style":"shaded","a":"1","b":"1.