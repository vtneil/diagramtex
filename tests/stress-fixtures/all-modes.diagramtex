"id":"board-2684"},{"type":"geo3d","x":2067,"y":43872,"src":"\\tdplotsetmaincoords{60}{110}\n\\begin{tikzpicture}[scale=3, tdplot_main_coords]\n  \\def\\rvec{0.8}\n  \\def\\thetavec{40}\n  \\def\\phivec{60}\n  \\coordinate (O) at (0,0,0);\n  \\draw[thick, ->] (0,0,0) -- (1,0,0) node[anchor=north east]{$x$};\n  \\draw[thick, ->] (0,0,0) -- (0,1,0) node[anchor=north west]{$y$};\n  \\draw[thick, ->] (0,0,0) -- (0,0,1) node[anchor=south]{$z$};\n  \\tdplotsetcoord{P}{\\rvec}{\\thetavec}{\\phivec}\n  \\draw[-stealth, color=red] (O) -- (P) node[above right]{$P$};\n  \\draw[dashed, color=red] (O) -- (Pxy);\n  \\draw[dashed, color=red] (P) -- (Pxy);\n  \\tdplotdrawarc{(O)}{0.2}{0}{\\phivec}{anchor=north}{$\\phi$}\n  \\tdplotsetthetaplanecoords{\\phivec}\n  \\tdplotdrawarc[tdplot_rotated_coords]{(0,0,0)}{0.5}{0}{\\thetavec}{anchor=south west}{$\\theta$}\n\\end{tikzpicture}","id":"board-2685"},{"type":"geo2d","x":2756,"y":43872,"src":"\\begin{tikzpicture}\n  % the vector v = (\\vlen; \\vang°): drag Q, or change the values\n  \\pgfmathsetmacro{\\vlen}{4}\n  \\pgfmathsetmacro{\\vang}{53.17}\n  \\pgfmathsetmacro{\\dx}{\\vlen*cos(\\vang)}\n  \\pgfmathsetmacro{\\dy}{\\vlen*sin(\\vang)}\n  \\draw[step=1, very thin, black!15] (-1,-1) grid (4,4);\n  \\draw[-stealth] (-1,0) -- (4.4,0) node[right]{$x$};\n  \\draw[-stealth] (0,-1) -- (0,4.4) node[above]{$y$};\n  \\foreach \\x in {1,...,3} \\draw (\\x,2pt) -- (\\x,-2pt) node[below]{$\\x$};\n  \\foreach \\y in {1,...,3} \\draw (2pt,\\y) -- (-2pt,\\y) node[left]{$\\y$};\n  \\coordinate (P) at (0,0);\n  \\coordinate (Q) at (\\vang:\\vlen);\n  \\coordinate (R) at (Q |- P);\n  \\draw[dashed, gray] (Q) -- (R) node[midway, right]{$\\Delta y = \\pgfmathprintnumber[fixed,precision=2]{\\dy}$};\n  \\path (P) -- (R) node[pos=0.62, above]{$\\Delta x = \\pgfmathprintnumber[fixed,precision=2]{\\dx}$};\n  \\pic[draw, \"$\\theta$\", angle radius=8mm] {angle = R--P--Q};\n  \\draw[-stealth, thick, blue] (P) -- (Q) node[midway, above left]{$\\vec{v}$};\n  \\fill (P) circle (1.5pt) node[below left]{$P$};\n  \\fill (Q) circle (1.5pt) node[above right]{$Q$};\n\\end{tikzpicture}","id":"board-2686"},{"type":"qc","x":3445,"y":43872,"src":"\\begin{quantikz}\n\\lstick{\\ket{0}} & \\gate{H} & \\ctrl{1} & \\meter{} \\\\\n\\lstick{\\ket{0}} & & \\targ{} & \\meter{}\n\\end{quantikz}","size":"large","font":"default","color":"#000000","id":"board-2687"},{"type":"forest","x":-4134,"y":44329,"src":"\\begin{forest}\n  for tree={draw, rounded corners}\n  [Root\n    [Branch [Leaf] [Leaf]]\n    [Branch [Leaf]]\n  ]\n\\end{forest}","size":"large","font":"default","color":"#000000","id":"board-2688"},{"type":"zx","x":-3445,"y":44329,"src":"\\begin{ZX}\n\\zxN{} \\rar &[\\zxwCol] \\zxZ{\\alpha} \\ar[r,o',H] \\ar[r,o.] &[\\zxHCol] \\zxX-{\\beta} \\rar &[\\zxwCol] \\zxN{}\n\\end{ZX}","color":"#000000","id":"board-2689"},{"type":"feynman","x":-2756,"y":44329,"src":"\\begin{feynman}\n  \\vertex (i1) at (0,1) {\\(e^-\\)};\n  \\vertex (i2) at (0,-1) {\\(e^+\\)};\n  \\vertex (a) at (1.25,0);\n  \\vertex (b) at (3.25,0);\n  \\vertex (f1) at (4.5,1) {\\(\\mu^-\\)};\n  \\vertex (f2) at (4.5,-1) {\\(\\mu^+\\)};\n  \\diagram* {\n    (i1) -- [fermion] (a) -- [fermion] (i2),\n    (a) -- [photon, edge label=\\(\\gamma\\), momentum'=\\(q\\)] (b),\n    (f2) -- [fermion] (b) -- [fermion] (f1),\n  };\n\\end{feynman}","color":"#000000","id":"board-2690"},{"type":"timing","x":-2067,"y":44329,"src":"\\begin{tikztimingtable}[timing/rowdist=3]\n  CLK & 8{2C} \\\\\n  D   & 3U 4D{A} 4D{B} 5U \\\\\n  Q   & 7X 4D{A} 5D{B} \\\\\n\\extracode\n  \\vertlines[help lines]{2,6,10,14}\n  \\draw [<->] (3,-1.5) -- node [above, font=\\footnotesize] {$t_{su}$} (6,-1.5);\n  \\draw [<->] (6,-4.5) -- node [above, font=\\footnotesize] {$t_{h}$} (7,-4.5);\n  \\draw [->] (6,-7.5) -- node [above, font=\\footnotesize] {$t_{co}$} (7,-7.5);\n\\end{tikztimingtable}","color":"#000000","id":"board-2691"},{"type":"automata","x":-1378,"y":44329,"src":"\\begin{tikzpicture}[->, >=Stealth, shorten >