] node {$a$} (q2)\n        (q2) edge [bend left] node {$b$} (q1);\n\\end{tikzpicture}","color":"#000000","id":"board-1168"},{"type":"uml","x":-689,"y":-13710,"src":"\\begin{tikzpicture}\n  \\begin{abstractclass}[text width=3.6cm]{Shape}{0,0}\n    \\attribute{- name : String}\n    \\operation[0]{+ area() : double}\n  \\end{abstractclass}\n  \\begin{class}[text width=3.2cm]{Circle}{-2.2,-3.4}\n    \\inherit{Shape}\n    \\attribute{- radius : double}\n    \\operation{+ area() : double}\n  \\end{class}\n  \\begin{class}[text width=3.2cm]{Square}{2.2,-3.4}\n    \\inherit{Shape}\n    \\attribute{- side : double}\n    \\operation{+ area() : double}\n  \\end{class}\n\\end{tikzpicture}","id":"board-1169"},{"type":"umlsd","x":0,"y":-13710,"src":"\\begin{sequencediagram}\n  \\newthread{c}{:Client}\n  \\newinst[1]{s}{:Server}\n  \\newinst[1]{d}{:Database}\n  \\begin{call}{c}{request()}{s}{response}\n    \\begin{call}{s}{query()}{d}{rows}\n    \\end{call}\n  \\end{call}\n\\end{sequencediagram}","id":"board-1170"},{"type":"kmap","x":689,"y":-13710,"src":"\\begin{karnaugh-map}[4][4][1][$D$][$C$][$B$][$A$]\n  \\minterms{0,2,5,7,8,10,13,15}\n  \\autoterms[0]\n  \\implicant{5}{15}\n  \\implicantcorner\n\\end{karnaugh-map}","color":"#000000","id":"board-1171"},{"type":"bytefield","x":1378,"y":-13710,"src":"\\begin{bytefield}[bitwidth=1.1em]{32}\n  \\bitheader{0,7,8,15,16,23,24,31} \\\\\n  \\begin{rightwordgroup}{Header}\n    \\bitbox{4}{Version} & \\bitbox{4}{IHL} & \\bitbox{8}{Type of service} & \\bitbox{16}{Total length} \\\\\n    \\bitbox{16}{Identification} & \\bitbox{3}{Flags} & \\bitbox{13}{Fragment offset}\n  \\end{rightwordgroup} \\\\\n  \\wordbox{1}{Source address} \\\\\n  \\wordbox[lrt]{1}{Data} \\\\\n  \\skippedwords \\\\\n  \\wordbox[lrb]{1}{}\n\\end{bytefield}","color":"#000000","id":"board-1172"},{"type":"chemfig","x":2067,"y":-13710,"src":"\\chemfig{H_3C-C(=[1]O)-[7]OH}","color":"#000000","id":"board-1173"},{"type":"cd","x":2756,"y":-13710,"src":"\\begin{tikzcd}\n  A \\