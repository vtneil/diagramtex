"x":1418,"y":264391,"w":320,"h":240,"axis":"z","base":"ellipse","cx":"1.8","cy":"2.2","a":"1.4","b":"1","r":"1 + 0.15*cos(3*t)","r1":"0.6","r2":"1.6","t1":"0","t2":"90","u1":"1","u2":"2.6 + 0.25*sin(2*x)","view":[115,20],"axes":true,"xlabel":"$x$","ylabel":"$y$","zlabel":"$z$","showBase":true,"dropLines":true,"hiddenEdges":true,"columns":false,"nx":"5","ny":"4","solidColor":"#2f7fc1","baseColor":"#e8703a","solidLabel":"$E$","baseLabel":"$D$","topLabel":"$z = u_2(x, y)$","bottomLabel":"$z = u_1(x, y)$","id":"page-2174"},{"type":"prim3d","x":2107,"y":264391,"w":240,"h":220,"kind":"box","style":"shaded","a":"2","b":"1.5","c":"1.2","r2":"0.6","n":"6","sl":"","r1":"0.8","t1":"0","t2":"70","p1":"20","p2":"60","view":[30,20],"axes":false,"axesNeg":true,"xlabel":"$x$","ylabel":"$y$","zlabel":"$z$","hiddenEdges":true,"solidColor":"#2f7fc1","la":"$a$","lb":"$b$","lc":"$c$","name":"","nameBelow":"","id":"page-2175"},{"type":"revolve","x":40,"y":264968,"w":320,"h":240,"f":"sqrt(x) + 0.3","g":"","a":"0","b":"3","axis":"x","sweep":"360","view":[25,18],"axes":true,"zaxis":false,"xlabel":"$x$","ylabel":"$y$","zlabel":"$z$","hiddenEdges":true,"showSlice":false,"x0":"","dx":"","showCurve":false,"curveLabel":"$y = f(x)$","sliceLabel":"","solidColor":"#2f7fc1","regionColor":"#e8703a","sliceColor":"#e8703a","id":"page-2176"},{"type":"geo3d","x":729,"y":264968,"src":"\\tdplotsetmaincoords{60}{110}\n\\begin{tikzpicture}[scale=3, tdplot_main_coords]\n  \\def\\rvec{0.8}\n  \\def\\thetavec{40}\n  \\def\\phivec{60}\n  \\coordinate (O) at (0,0,0);\n  \\draw[thick, ->] (0,0,0) -- (1,0,0) node[anchor=north east]{$x$};\n  \\draw[thick, ->] (0,0,0) -- (0,1,0) node[anchor=north west]{$y$};\n  \\draw[thick, ->] (0,0,0) -- (0,0,1) node[anchor=south]{$z$};\n  \\tdplotsetcoord{P}{\\rvec}{\\thetavec}{\\phivec}\n  \\draw[-stealth, color=red] (O) -- (P) node[above right]{$P$};\n  \\draw[dashed, color=red] (O) -- (Pxy);\n  \\draw[dashed, color=red] (P) -- (Pxy);\n  \\tdplotdrawarc{(O)}{0.2}{0}{\\phivec}{anchor=north}{$\\phi$}\n  \\tdplotsetthetaplanecoords{\\phivec}\n  \\tdplotdrawarc[tdplot_rotated_coords]{(0,0,0)}{0.5}{0}{\\thetavec}{anchor=south west}{$\\theta$}\n\\end{tikzpicture}","id":"page-2177"},{"type":"geo2d","x":1418,"y":264968,"src":"\\begin{tikzpicture}\n  % the vector v = (\\vlen; \\vang°): drag Q, or change the values\n  \\pgfmathsetmacro{\\vlen}{4}\n  \\pgfmathsetmacro{\\vang}{53.17}\n  \\pgfmathsetmacro{\\dx}{\\vlen*cos(\\vang)}\n  \\pgfmathsetmacro{\\dy}{\\vlen*sin(\\vang)}\n  \\draw[step=1, very thin, black!15] (-1,-1) grid (4,4);\n  \\draw[-stealth] (-1,0) -- (4.4,0) node[right]{$x$};\n  \\draw[-stealth] (0,-1) -- (0,4.4) node[above]{$y$};\n  \\foreach \\x in {1,...,3} \\draw (\\x,2pt) -- (\\x,-2pt) node[below]{$\\x$};\n  \\foreach \\y in {1,...,3} \\draw (2pt,\\y) -- (-2pt,\\y) node[left]{$\\y$};\n  \\coordinate (P) at (0,0);\n  \\coordinate (Q) at (\\vang:\\vlen);\n  \\coordinate (R) at (Q |- P);\n  \\draw[dashed, gray] (Q) -- (R) node[midway, right]{$\\Delta y = \\pgfmathprintnumber[fixed,precision=2]{\\dy}$};\n  \\path (P) -- (R) node[pos=0.62, above]{$\\Delta x = \\pgfmathprintnumber[fixed,precision=2]{\\dx}$};\n  \\pic[draw, \"$\\theta$\", angle radius=8mm] {angle = R--P--Q};\n  \\draw[-stealth, thick, blue] (P) -- (Q) node[midway, above left]{$\\vec{v}$};\n  \\fill (P) circle (1.5pt) node[below left]{$P$};\n  \\fill (Q) circle (1.5pt) node[above right]{$Q$};\n\\end{tikzpicture}","id":"page-2178"},{"type":"qc","x":2107,"y":264968,"src":"\\begin{quantikz}\n\\lstick{\\ket{0}} & \\gate{H} & \\ctrl{1} & \\meter{} \\\\\n\\lstick{\\ket{0}} & & \\targ{} & \\meter{}\n\\end{quantikz}","size":"large","font":"default","color":"#000000","id":"page-2179"},{"type":"forest","x":40,"y":265425,"src":"\\begin{forest}\n  for tree={draw, rounded corners}\n  [Root\n    [Branch [Leaf] [Leaf]]\n    [Branch [Leaf]]\n  ]\n\\end{forest}","size":"large","font":"default","color":"#000000","id":"page-2180"},{"type":"zx","x":729,"y":265425,"src":"\\begin{ZX}\n\\zxN{} \\rar &[\\zxwCol] \\zxZ{\\alpha} \\ar[r,o',H] \\ar[r,o.] &[\\zxHCol] \\zxX-{\\beta} \\rar &[\\zxwCol] \\zxN{}\n\\end{ZX}","color":"#000000","id":"page-2181"},{"type":"feynman","x":1418,"y":265425,"src":"\\begin{feynman}\n  \\vertex (i1) at (0,1) {\\(e^-\\)};\n  \\vertex (i2) at (0,-1) {\\(e^+\\)};\n  \\vertex (a) at (1.25,0);\n  \\vertex (b) at (3.25,0);\n  \\vertex (f1) at (4.5,1) {\\(\\mu^-\\)};\n  \\vertex (f2) at (4.5,-1) {\\(\\mu^+\\)};\n  \\diagram* {\n    (i1) -- [fermion] (a) -- [fermion] (i2),\n    (a) -- [photon, edge label=\\(\\gamma\\), momentum'=\\(q\\)] (b),\n    (f2) -- [fermion] (b) -- [fermion] (f1),\n  };\n\\end{feynman}","color":"#000000","id":"page-2182"},{"type":"timing","x":2107,"y":265425,"src":"\\begin{tikztimingtable}[timing/rowdist=3]\n  CLK & 8{2C} \\\\\n  D   & 3U 4D{A} 4D{B} 5U \\\\\n  Q   & 7X 4D{A} 5D{B} \\\\\n\\extracode\n  \\vertlines[help lines]{2,6,10,14}\n  \\draw [<->] (3,-1.5) -- node [above, font=\\footnotesize] {$t_{su}$} (6,-1.5);\n  \\draw [<->] (6,-4.5) -- node [above, font=\\footnotesize] {$t_{h}$} (7,-4.5);\n  \\draw [->] (6,-7.5) -- node [above, font=\\footnotesize] {$t_{co}$} (7,-7.5);\n\\end{tikztimingtable}","color":"#000000","id":"page-2183"},{"type":"automata","x":40,"y":265882,"src":"\\begin{tikzpicture}[->, >=Stealth, shorten >=1pt, auto, node distance=2.5cm, semithick]\n  \\node[state, initial] (q0) at (0,0) {$q_0$};\n  \\node[state] (q1) at (2.5,0) {$q_1$};\n  \\node[state, accepting] (q2) at (5,0) {$q_2$};\n  \\path (q0) edge node {$a$} (q1)\n        (q1) edge [loop above] node {$b$} ()\n        (q1) edge [bend left] node {$a$} (q2)\n        (q2) edge [bend left] node {$b$} (q1);\n\\end{tikzpicture}","color":"#000000","id":"page-2184"},{"type":"uml","x":729,"y":265882,"src":"\\begin{tikzpicture}\n  \\begin{abstractclass}[text width=3.6cm]{Shape}{0,0}\n    \\attribute{- name : String}\n    \\operation[0]{+ area() : double}\n  \\end{abstractclass}\n  \\begin{class}[text width=3.2cm]{Circle}{-2.2,-3.4}\n    \\inherit