id":"diagram-396"},{"type":"prim3d","x":3485,"y":22433,"w":240,"h":220,"kind":"box","style":"shaded","a":"2","b":"1.5","c":"1.2","r2":"0.6","n":"6","sl":"","r1":"0.8","t1":"0","t2":"70","p1":"20","p2":"60","view":[30,20],"axes":false,"axesNeg":true,"xlabel":"$x$","ylabel":"$y$","zlabel":"$z$","hiddenEdges":true,"solidColor":"#2f7fc1","la":"$a$","lb":"$b$","lc":"$c$","name":"","nameBelow":"","id":"diagram-397"},{"type":"revolve","x":4174,"y":22433,"w":320,"h":240,"f":"sqrt(x) + 0.3","g":"","a":"0","b":"3","axis":"x","sweep":"360","view":[25,18],"axes":true,"zaxis":false,"xlabel":"$x$","ylabel":"$y$","zlabel":"$z$","hiddenEdges":true,"showSlice":false,"x0":"","dx":"","showCurve":false,"curveLabel":"$y = f(x)$","sliceLabel":"","solidColor":"#2f7fc1","regionColor":"#e8703a","sliceColor":"#e8703a","id":"diagram-398"},{"type":"geo3d","x":4863,"y":22433,"src":"\\tdplotsetmaincoords{60}{110}\n\\begin{tikzpicture}[scale=3, tdplot_main_coords]\n  \\def\\rvec{0.8}\n  \\def\\thetavec{40}\n  \\def\\phivec{60}\n  \\coordinate (O) at (0,0,0);\n  \\draw[thick, ->] (0,0,0) -- (1,0,0) node[anchor=north east]{$x$};\n  \\draw[thick, ->] (0,0,0) -- (0,1,0) node[anchor=north west]{$y$};\n  \\draw[thick, ->] (0,0,0) -- (0,0,1) node[anchor=south]{$z$};\n  \\tdplotsetcoord{P}{\\rvec}{\\thetavec}{\\phivec}\n  \\draw[-stealth, color=red] (O) -- (P) node[above right]{$P$};\n  \\draw[dashed, color=red] (O) -- (Pxy);\n  \\draw[dashed, color=red] (P) -- (Pxy);\n  \\tdplotdrawarc{(O)}{0.2}{0}{\\phivec}{anchor=north}{$\\phi$}\n  \\tdplotsetthetaplanecoords{\\phivec}\n  \\tdplotdrawarc[tdplot_rotated_coords]{(0,0,0)}{0.5}{0}{\\thetavec}{anchor=south west}{$\\theta$}\n\\end{tikzpicture}","id":"diagram-399"},{"type":"geo2d","x":40,"y":22890,"src":"\\begin{tikzpicture}\n  % the vector v = (\\vlen; \\vang°): drag Q, or change the values\n  \\pgfmathsetmacro{\\vlen}{4}\n  \\pgfmathsetmacro{\\vang}{53.17}\n  \\pgfmathsetmacro{\\dx}{\\vlen*cos(\\vang)}\n  \\pgfmathsetmacro{\\dy}{\\vlen*sin(\\vang)}\n  \\draw[step=1, very thin, black!15] (-1,-1) grid (4,4);\n  \\draw[-stealth] (-1,0) -- (4.4,0) node[right]{$x$};\n  \\draw[-stealth] (0,-1) -- (0,4.4) node[above]{$y$};\n  \\foreach \\x in {1,...,3} \\draw (\\x,2pt) -- (\\x,-2pt) node[below]{$\\x$};\n  \\foreach \\y in {1,...,3} \\draw (2pt,\\y) -- (-2pt,\\y) node[left]{$\\y$};\n  \\coordinate (P) at (0,0);\n  \\coordinate (Q) at (\\vang:\\vlen);\n  \\coordinate (R) at (Q |- P);\n  \\draw[dashed, gray] (Q) -- (R) node[midway, right]{$\\Delta y = \\pgfmathprintnumber[fixed,precision=2]{\\dy}$};\n  \\path (P) -- (R) node[pos=0.62, above]{$\\Delta x = \\pgfmathprintnumber[fixed,precision=2]{\\dx}$};\n  \\pic[draw, \"$\\theta$\", angle radius=8mm] {angle = R--P--Q};\n  \\draw[-stealth, thick, blue] (P) -- (Q) node[midway, above left]{$\\vec{v}$};\n  \\fill (P) circle (1.5pt) node[below left]{$P$};\n  \\fill (Q) circle (1.5pt) node[above right]{$Q$};\n\\end{tikzpicture}","id":"diagram-400"},{"type":"qc","x":729,"y":22890,"src":"\\begin{quantikz}\n\\lstick{\\ket{0}} & \\gate{H} & \\ctrl{1} & \\meter{} \\\\\n\\lstick{\\ket{0}} & & \\targ{} & \\meter{}\n\\end{quantikz}","size":"large","font":"default","color":"#000000","id":"diagram-401"},{"type":"forest","x":1418,"y":22890,"src":"\\begin{forest}\n  for tree={draw, rounded corners}\n  [Root\n    [Branch [Leaf] [Leaf]]\n    [Branch [Leaf]]\n  ]\n\\end{forest}","size":"large","font":"default","color":"#000000","id":"diagram-402"},{"type":"zx","x":2107,"y":22890,"src":"\\begin{ZX}\n\\zxN{} \\rar &[\\zxwCol] \\zxZ{\\alpha} \\ar[r,o',H] \\ar[r,o.] &[\\zxHCol] \\zxX-{\\beta} \\rar &[\\zxwCol] \\zxN{}\n\\end{ZX}","color":"#000000","id":"diagram-403"},{"type":"feynman","x":2796,"y":22890,"src":"\\begin{feynman}\n  \\vertex (i1) at (0,1) {\\(e^-\\)};\n  \\vertex (i2) at (0,-1) {\\(e^+\\)};\n  \\vertex (a) at (1.25,0);\n  \\vertex (b) at (3.25,0);\n  \\vertex (f1) at (4.5,1) {\\(\\mu^-\\)};\n  \\vertex (f2) at (4.5,-1) {\\(\\mu^+\\)};\n  \\diagram* {\n    (i1) -- [fermion] (a) -- [fermion] (i2),\n    (a) -- [photon, edge label=\\(\\gamma\\), momentum'=\\(q\\)] (b),\n    (f2) -- [fermion] (b) -- [fermion] (f1),\n  };\n\\end{feynman}","color":"#000000","id":"diagram-404"},{"type":"timing","x":3485,"y":22890,"src":"\\begin{tikztimingtable}[timing/rowdist=3]\n  CLK & 8{2C} \\\\\n  D   & 3U 4D{A} 4D{B} 5U \\\\\n  Q   & 7X 4D{A} 5D{B} \\\\\n\\extracode\n  \\vertlines[help lines]{2,6,10,14}\n  \\draw [<->] (3,-1.5) -- node [above, font=\\footnotesize] {$t_{su}$} (6,-1.5);\n  \\draw [<->] (6,-4.5) -- node [above, font=\\footnotesize] {$t_{h}$} (7,-4.5);\n  \\draw [->] (6,-7.5) -- node [above, font=\\footnotesize] {$t_{co}$} (7,-7.5);\n\\end{tikztimingtable}","color":"#000000","id":"diagram-405"},{"type":"automata","x":4174,"y":22890,"src":"\\begin{tikzpicture}[->, >=Stealth, shorten >=1pt, auto, node distance=2.5cm, semithick]\n  \\node[state, initial] (q0) at (0,0) {$q_0$};\n  \\node[state] (q1) at (2.5,0) {$q_1$};\n  \\node[state, accepting] (q2) at (5,0) {$q_2$};\n  \\path (q0) edge node {$a$} (q1)\n        (q1) edge [loop above] node {$b$} ()\n        (q1) edge [bend left] node {$a$} (q2)\n        (q2) edge [bend left] node {$b$} (q1);\n\\end{tikzpicture}","color":"#000000","id":"diagram-406"},{"type":"uml","x":4863,"y":22890,"src":"\\begin{tikzpicture}\n  \\begin{abstractclass}[text width=3.6cm]{Shape}{0,0}\n    \\attribute{- name : String}\n    \\operation[0]{+ area() : double}\n  \\end{abstractclass}\n  \\begin{class}[text width=3.2cm]{Circle}{-2.2,-3.4}\n    \\inherit{Shape}\n    \\attribute{- radius : double}\n    \\operation{+ area() : double}\n  \\end{class}\n  \\begin{class}[text width=3.2cm]{Square}{2.2,-3.4}\n    \\inherit{Shape}\n    \\attribute{- side : double}\n    \\operation{+ area() : double}\n  \\end{class}\n\\end{tikzpicture}","id":"diagram-407"},{"type":"umlsd","x":40,"y":23347,"src":"\\begin{sequencediagram}\n  \\newthread{c}{:Client}\n  \\newinst[1]{s}{:Server}\n  \\newinst[1]{d}{:Database}\n  \\begin{call}{c}{request()}{s}{response}\n    \\begin{call}{s}{query()}{d}{rows}\n    \\end{call}\n  \\end{call}\n\\end{sequencediagram}","id":"diagram-408"},{"type":"kmap","x":729,"y":23347,"src":"\\begin{karnaugh-map}[4][4][1][$D$][$C$][$B$][$A$]\n  \\minterms{0,2,5,7,8,10,13,15}\n  \\autoterms[0]\n  \\implicant{5}{15}\n  \\implicantcorner\n\\end{karnaugh-map}","color":"#000000","id":"diagram-409"},{"type":"bytefield","x":1418,"y":23347,"src":"\\begin{bytefield}[bitwidth=1.1em]{32}\n  \\bitheader{0,7,8,15,16,23,24,31} \\\\\n  \\begin{rightwordgroup}{Header}\n    \\bitbox{4}{Version} & \\bitbox{4}{IHL} & \\bitbox{8}{Type of service} & \\bitbox{16}{Total length} \\\\\n    \\bitbox{16}{Identification} & \\bitbox{3}{Flags} & \\bitbox{13}{Fragment offset}\n  \\end{rightwordgroup} \\\\\n  \\wordbox{1}{Source address} \\\\\n  \\wordbox[lrt]{1}{Data} \\\\\n  \\skippedwords \\\\\n  \\wordbox[lrb]{1}{}\n\\end{bytefield}","color":"#000000","id":"diagram-410"},{"type":"chemfig","x":2107,"y":23347,"src":"\\chemfig{H_3C-C(=[1]O)-[7]OH}","color":"#000000","id":"diagram-411"},{"type":"cd","x":2796,"y":23347,"src":"\\begin{tikzcd}\n  A \\arrow[r, \"f\"] \\arrow[d, \"g\"'] & B \\arrow[d, \"h\"] \\\\\n  C \\arrow[r, \"k\"']                  & D\n\\end{tikzcd}","color":"#000000","id":"diagram-412"},{"type":"xy","x":3485,"y":23347,"src":"\\xymatrix{\n  A \\ar[r]^{f} \\ar[d]_{g} & B \\ar[d]^{h} \\\\\n  C \\ar[r]_{k}             & D\n}","color":"#000000","id":"diagram-413"},{"type":"bloch","x":4174,"y":23347,"src":"\\begin{blochsphere}[radius=1.5cm, tilt=15, rotation=-20]\n  \\drawBallGrid[style={opacity=0.3}]{30}{30}\n  \\drawAxis[scale=1.3, axisarrow={->}]{0}{0}\n  \\labelPolar[scale=1.45]{z}{0}{0}\n  \\node at (z) {$z$};\n  \\drawStatePolar{psi}{50}{70}\n  \\node[above right] at (psi) {$\\psi$};\n\\end{blochsphere}","id":"diagram-414"},{"type":"cz","x":4894.98,"y":23456.36,"items":[{"id":"diagram-415-part-0","part":"src:vsource-eu","a":[0,0],"b":[0,2],"l":"$V$","ann":"","v":"","i":"","poles":"","name":"","opts":""},{"id":