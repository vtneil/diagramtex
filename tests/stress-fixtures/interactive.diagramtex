_{95}$"},{"type":"diagram","shapes":[{"type":"physics","x":40,"y":40,"src":"\\physics{optics}\n% a converging lens forms a real, inverted image: drag the object or the focus\n\\axis(-5, 9)\n\\object[h=1.2, label=$O$](-3.5)\n\\lens[f=2, h=3.4, label=$L$](0)","id":"document-84"},{"type":"physics","x":729,"y":40,"src":"\\physics{fields}\n% an electric dipole: field lines and equipotentials\n\\charge[q=1nC, label=$+q$](-1.2, 0)\n\\charge[q=-1nC, label=$-q$](1.2, 0)\n\\fieldlines[n=12]\n\\equipotentials[n=3]\n\\probe[label=$P$](0, 1.5)","id":"document-85"},{"type":"physics","x":1418,"y":40,"src":"\\physics{waves}\n% two coherent sources: crests, antinodal (solid) and nodal (dashed) lines\n\\sources[d=1.6, lambda=0.6, n=6](0, 0)","id":"document-86"},{"type":"physics","x":2107,"y":40,"src":"\\physics{spacetime}\n% a frame moving at 0.5c: its axes tilt toward the light line; drag the event\n\\range(-1, 4)(-0.5, 4)\n\\frame[beta=0.5, name=S']\n\\lightcone(0, 0)\n\\event[label=$A$, guides=true](2, 3)","id":"document-87"},{"type":"physics","x":40,"y":497,"src":"\\physics{levels}\n% the Balmer series of hydrogen and its visible spectrum\n\\setup[scale=0.32]\n\\hydrogen[n=6]\n\\transition(3)(2)\n\\transition(4)(2)\n\\transition(5)(2)\n\\transition(6)(2)\n\\spectrum(0, -6)","id":"document-88"},{"type":"physics","x":729,"y":497,"src":"\\physics{mechanics}\n% a block on a rough incline: drag the top corner to change the angle\n\\incline[angle=30, L=5, mu=0.4](0, 0)\n\\block[m=2, s=0.55, label=$m$](incline)","id":"document-89"},{"type":"prim3d","x":1418,"y":497,"w":240,"h":220,"kind":"box","style":"shaded","a":"2","b":"1.5","c":"1.2","r2":"0.6","n":"6","sl":"","r1":"0.8","t1":"0","t2":"70","p1":"20","p2":"60","view":[30,20],"axes":false,"axesNeg":true,"xlabel":"$x$","ylabel":"$y$","zlabel":"$z$","hiddenEdges":true,"solidColor":"#2f7fc1","la":"$a$","lb":"$b$","lc":"$c$","name":"","nameBelow":"","id":"document-90"},{"type":"prim3d","x":2107,"y":497,"w":200,"h":200,"kind":"sphere","sty